{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "React Vite",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "noEmit": true,
    "useDefineForClassFields": true
  }
}
