# ==============================================
# JXP-Studio Environment Configuration
# ==============================================

# WordPress Headless CMS & WPGraphQL
WP_ENV=development
WORDPRESS_PORT=8080
PMA_PORT=8081
WORDPRESS_DB_NAME=jxp_wordpress
WORDPRESS_DB_USER=jxp_user
WORDPRESS_DB_PASSWORD=jxp_secure_password
WORDPRESS_DB_ROOT_PASSWORD=jxp_root_password
WORDPRESS_URL=http://localhost:8080
WPGRAPHQL_ENDPOINT=http://localhost:8080/graphql

# WPGraphQL JWT Authentication Secret
# Generate a secure 64+ char random string
WP_JWT_SECRET=change_me_to_a_secure_random_string_in_production
GRAPHQL_JWT_AUTH_SECRET_KEY=change_me_to_a_secure_random_string_in_production

# Optional WordPress App Password or Auth Header for preview mode / mutations
WP_APP_USER=admin
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Services API (FastAPI)
API_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./services/api/jxp.db

# Stripe (Stub / Billing)
STRIPE_SECRET_KEY=sk_test_placeholder

# Frontend Apps Ports
PORT_WEB=3000
PORT_HUB=5173
