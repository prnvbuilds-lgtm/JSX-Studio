[
  {
    "key": "group_jxp_listing_fields",
    "title": "Listing Details & Specs",
    "fields": [
      {
        "key": "field_listing_tagline",
        "label": "Tagline",
        "name": "tagline",
        "type": "text",
        "show_in_graphql": 1
      },
      {
        "key": "field_listing_price_tier",
        "label": "Price Tier",
        "name": "price_tier",
        "type": "select",
        "choices": {
          "$": "$ (Budget-Friendly)",
          "$$": "$$ (Moderate)",
          "$$$": "$$$ (Upscale)",
          "$$$$": "$$$$ (Luxury / Ultra)"
        },
        "show_in_graphql": 1
      },
      {
        "key": "field_listing_rating",
        "label": "Rating Score (1-5)",
        "name": "rating",
        "type": "number",
        "step": "0.1",
        "min": 1,
        "max": 5,
        "show_in_graphql": 1
      },
      {
        "key": "field_listing_review_count",
        "label": "Review Count",
        "name": "review_count",
        "type": "number",
        "show_in_graphql": 1
      },
      {
        "key": "field_listing_address",
        "label": "Street Address",
        "name": "address",
        "type": "text",
        "show_in_graphql": 1
      },
      {
        "key": "field_listing_city",
        "label": "City",
        "name": "city",
        "type": "text",
        "show_in_graphql": 1
      },
      {
        "key": "field_listing_coordinates",
        "label": "Coordinates (Lat, Lng)",
        "name": "coordinates",
        "type": "text",
        "show_in_graphql": 1
      },
      {
        "key": "field_listing_contact_phone",
        "label": "Contact Phone",
        "name": "contact_phone",
        "type": "text",
        "show_in_graphql": 1
      },
      {
        "key": "field_listing_contact_email",
        "label": "Contact Email",
        "name": "contact_email",
        "type": "email",
        "show_in_graphql": 1
      },
      {
        "key": "field_listing_website_url",
        "label": "Website URL",
        "name": "website_url",
        "type": "url",
        "show_in_graphql": 1
      },
      {
        "key": "field_listing_booking_url",
        "label": "Direct Booking / Reservation URL",
        "name": "booking_url",
        "type": "url",
        "show_in_graphql": 1
      },
      {
        "key": "field_listing_verification_status",
        "label": "Verification Status",
        "name": "verification_status",
        "type": "select",
        "choices": {
          "verified": "Verified JXP Partner",
          "featured": "Featured Spot",
          "pending": "Pending Verification"
        },
        "show_in_graphql": 1
      },
      {
        "key": "field_listing_partner_id",
        "label": "Partner Account ID / Slug",
        "name": "partner_id",
        "type": "text",
        "show_in_graphql": 1
      }
